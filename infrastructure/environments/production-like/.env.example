# ---------------------------------------------------------------------------
# Environment template for the production-like load environment (GAP-083).
#
# Copy this file to `.env` in this directory and fill in every secret:
#
#     cp .env.example .env
#
# `.env` is git-ignored; `.env.example` is committed and holds placeholders
# only. Never put a real credential in this file.
#
# Every value below also documents the resource allocation for the tier it
# belongs to. Sizing rationale is in sizing.md; do not change a core set without
# reading it, because the tiers are pinned so that the generator and the stack
# cannot share a CPU.
#
# The host these defaults assume is 24 logical cores / 32 GB, which is the
# "co-resident VMs on one physical host" option from README.md. If you are on a
# different shape, adjust the *_CPUSET values and the memory limits together.
# ---------------------------------------------------------------------------

# --- Host allocation (cores) ------------------------------------------------
# The whole point of the exercise: these sets must not overlap.
#   data 0-3 (4) | edge 4-7 (4) | app 8-15 (8) | generator 16-21 (6) | obs 22-23 (2)
DATA_CPUSET=0-3
EDGE_CPUSET=4-7
APP_CPUSET=8-15
GENERATOR_CPUSET=16-21
OBS_CPUSET=22-23

# --- Host allocation (memory) ----------------------------------------------
POSTGRES_MEM_LIMIT=2048m
POSTGRES_MEM_RESERVE=1024m
REDIS_MEM_LIMIT=448m
REDIS_MEM_RESERVE=128m
PGBOUNCER_MEM_LIMIT=256m
NGINX_MEM_LIMIT=256m
BACKEND_MEM_LIMIT=2560m
BACKEND_MEM_RESERVE=1024m
FRONTEND_MEM_LIMIT=512m
PROMETHEUS_MEM_LIMIT=768m
GRAFANA_MEM_LIMIT=384m
LOKI_MEM_LIMIT=512m
PROMTAIL_MEM_LIMIT=256m
EXPORTER_MEM_LIMIT=128m
GENERATOR_MEM_LIMIT=4096m
GENERATOR_MEM_RESERVE=1024m

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=exam_platform
POSTGRES_USER=exam_app
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_EFFECTIVE_CACHE=1536MB
POSTGRES_WORK_MEM=8MB
POSTGRES_MAINTENANCE_WORK_MEM=128MB
# Must exceed PGBOUNCER_DEFAULT_POOL_SIZE plus headroom for Flyway and the
# exporter, or a pooler restart cannot drain and reconnect.
POSTGRES_MAX_CONNECTIONS=300
# Log any statement slower than this; the load evidence quotes the slowest.
POSTGRES_LOG_SLOW_MS=500

# --- PgBouncer --------------------------------------------------------------
PGBOUNCER_ADMIN_USER=pgbouncer_admin
PGBOUNCER_ADMIN_PASSWORD=replace-with-a-strong-password
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_MAX_PREPARED_STATEMENTS=100
# Sized for 5,000 users. The local stack's 200/20 caps the platform at 200
# concurrent database clients and is not a valid capacity claim.
PGBOUNCER_MAX_CLIENT_CONN=2000
PGBOUNCER_DEFAULT_POOL_SIZE=100
PGBOUNCER_MIN_POOL_SIZE=20
PGBOUNCER_RESERVE_POOL_SIZE=25

# --- Redis ------------------------------------------------------------------
REDIS_PASSWORD=replace-with-a-strong-password
REDIS_MAXMEMORY=384mb

# --- Backend ----------------------------------------------------------------
# Per-instance Hikari pool. 40 against a 100-connection PgBouncer pool leaves room
# for a second instance without exhausting the pooler.
DB_POOL_MAX_SIZE=40
DB_POOL_MIN_IDLE=10
JWT_ISSUER=exam-platform
# At least 32 characters. Generate per environment: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ALLOWED_ORIGINS=http://localhost:8090
# Prometheus presents this to reach /actuator/prometheus (GAP-138).
MONITORING_METRICS_TOKEN=replace-with-a-random-token

# --- Edge -------------------------------------------------------------------
# The committed nginx.conf uses worker_connections 1024, a development default
# that cannot serve 5,000 concurrent users (each proxied request uses two
# connections). The entrypoint rewrites these capacity directives at start-up.
NGINX_WORKER_CONNECTIONS=16384
NGINX_WORKER_RLIMIT_NOFILE=65536

EDGE_HTTP_PORT=8090
# Relative base: the edge serves the UI and the API from one origin, so the browser resolves this
# against whatever host served the page. An absolute origin would tie the built image to one
# hostname and break every other one against the edge CSP (GAP-164).
NEXT_PUBLIC_API_BASE_URL=/api/v1

# --- Observability ----------------------------------------------------------
PROMETHEUS_HOST_PORT=9091
PROMETHEUS_RETENTION=30d
GRAFANA_HOST_PORT=3011
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-password
LOKI_HOST_PORT=3110

# --- Delivery worker --------------------------------------------------------
# Dataset construction raises these; the measurement run sets ENABLED=false so
# snapshot preparation cannot compete with the measured workload.
DELIVERY_WORKER_ENABLED=true
DELIVERY_WORKER_BATCH_SIZE=250
DELIVERY_WORKER_INTERVAL=PT5S

# --- Load generator ---------------------------------------------------------
P7_PROFILE=start
P7_USERS=5000
P7_VUS=5000
P7_DURATION_SECONDS=60
P7_OFFSET=0
P7_SCHEDULE_ID=
P7_TIMEOUT=60s

# Evaluation worker. The application default is false (application.yml); with the default a
# submit-triggered EVALUATION job is queued and never claimed, so no result is ever published.
# Set true for any environment that must evaluate submissions.
EVALUATION_WORKER_ENABLED=true
EVALUATION_WORKER_BATCH_SIZE=50
EVALUATION_WORKER_INTERVAL=PT10S
