# ---------------------------------------------------------------------------
# Smart Competitive Examination Platform — repository ignore rules
# Generated files are not committed. See specs/09-P0-Foundation-V1.5.md §93.
# ---------------------------------------------------------------------------

# --- Environment / secrets (never commit) ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
secrets/
!docs/**/example*.env

# --- Java / Maven ---
target/
build/
!**/src/**/build/
*.class
*.jar
*.war
*.ear
hs_err_pid*
replay_pid*
.mvn/wrapper/maven-wrapper.jar.bak

# --- Node / Next.js ---
node_modules/
.next/
out/
.turbo/
.vercel/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Test / coverage output ---
coverage/
.nyc_output/
test-results/
junit.xml
*.hprof

# --- Logs ---
logs/
*.log
!docs/**/*.log.md

# --- Local runtime data ---
# Anchored to the repository root so these match the local runtime directories only. Without the
# leading slash, `reports/` also matched the Next.js route segments `app/*/reports/`, which silently
# excluded the reporting screens from version control.
/data/
/pgdata/
/redis-data/
/uploads/
/reports/
/imports/
infrastructure/monitoring/grafana/data/
infrastructure/monitoring/loki/data/

# --- Local TLS material for the edge (never commit a private key) ---
infrastructure/nginx/certs/*
!infrastructure/nginx/certs/README.md
docker-compose.override.yml

# --- IDE / editor ---
.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.settings/
.project
.classpath
.factorypath
*.swp
*~

# --- OS ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Tooling caches ---
.eslintcache
.stylelintcache
.npm/
.pnpm-store/
.dsh