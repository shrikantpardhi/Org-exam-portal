# Canonical formatting for the repository (specs/09-P0-Foundation-V1.5.md §113).
# Editors and agents use these settings instead of local preferences.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{java,xml}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{sql,json,yml,yaml}]
indent_size = 2

[Makefile]
indent_style = tab
