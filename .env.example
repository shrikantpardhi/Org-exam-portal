# ---------------------------------------------------------------------------
# Example environment configuration.
#
# Copy to `.env` for local development. NEVER commit a real `.env`.
# These values are development-only defaults (specs/09-P0-Foundation-V1.5.md §67, §99).
# No production secret belongs in this file.
# ---------------------------------------------------------------------------

# --- Application ---
SPRING_PROFILES_ACTIVE=local
APP_ENVIRONMENT=local

# --- PostgreSQL (direct, local development) ---
POSTGRES_DB=exam_platform
POSTGRES_USER=exam_app
POSTGRES_PASSWORD=exam_local_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- PgBouncer (production/staged connection path) ---
PGBOUNCER_HOST=localhost
PGBOUNCER_PORT=6432

# --- Redis (cache only) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Backend HTTP ---
SERVER_PORT=8080

# --- JWT (development placeholder only; use a real secret via secret manager in production) ---
# Must be at least 32 characters. Rotate per environment. Never reuse across environments.
JWT_ISSUER=exam-platform
JWT_SECRET=local-development-only-secret-change-me-please-32b
JWT_ACCESS_TOKEN_TTL_SECONDS=3600

# --- CORS (comma-separated trusted origins; never a wildcard in production) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- File storage ---
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=./data/uploads

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
