# ---------------------------------------------------------------------------
# Example environment configuration.
#
# Copy to `.env` for local development. NEVER commit a real `.env`.
# These values are development-only defaults (specs/09-P0-Foundation-V1.5.md §67, §99).
# No production secret belongs in this file.
# ---------------------------------------------------------------------------

# --- Application ---
SPRING_PROFILES_ACTIVE=local
APP_ENVIRONMENT=local

# --- PostgreSQL (direct, local development) ---
POSTGRES_DB=exam_platform
POSTGRES_USER=exam_app
POSTGRES_PASSWORD=exam_local_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- PgBouncer (production/staged connection path) ---
PGBOUNCER_HOST=localhost
PGBOUNCER_PORT=6432

# --- Redis (cache only) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Backend HTTP ---
SERVER_PORT=8080

# --- JWT (development placeholder only; use a real secret via secret manager in production) ---
# Must be at least 32 characters. Rotate per environment. Never reuse across environments.
JWT_ISSUER=exam-platform
JWT_SECRET=local-development-only-secret-change-me-please-32b
JWT_ACCESS_TOKEN_TTL_SECONDS=3600

# --- CORS (comma-separated trusted origins; never a wildcard in production) ---
# 8081 is the Nginx edge, 3000 is the frontend when run directly with `npm run dev`.
#
# The loopback IP is listed alongside `localhost` because they are DIFFERENT origins to a browser:
# `http://127.0.0.1:8081` is not `http://localhost:8081`. A deployment reached at the IP would
# otherwise be refused. Add every hostname the deployment is actually served from (GAP-165).
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:3000

# --- File storage ---
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=./data/uploads

# --- Frontend ---
# Inlined into the browser bundle at build time. Use the RELATIVE base `/api/v1`: the edge serves
# the UI and the API from one origin, so the browser resolves it against whatever host it loaded
# the page from. An absolute origin here bakes one hostname into the image and breaks every other
# host against the edge CSP (GAP-165). This value must match the frontend Dockerfile default.
NEXT_PUBLIC_API_BASE_URL=/api/v1

# ---------------------------------------------------------------------------
# Container stack (docker-compose.yml)
#
# Every value below is read by Compose. The service-name hosts (postgres,
# redis, pgbouncer) are set inside docker-compose.yml, never here, so this file
# stays usable for host-run tooling as well.
# ---------------------------------------------------------------------------

# --- Redis authentication ---
REDIS_PASSWORD=exam_local_redis_password

# --- PgBouncer authentication ---
# POSTGRES_USER is the application user PgBouncer authenticates and connects as.
# The admin/stats console user is separate and exists only inside PgBouncer.
PGBOUNCER_ADMIN_USER=pgbouncer_admin
PGBOUNCER_ADMIN_PASSWORD=exam_local_pgbouncer_password
# Transaction pooling with tracked server-side prepared statements (PgBouncer >= 1.21).
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_MAX_PREPARED_STATEMENTS=100

# --- Edge (Nginx) ---
EDGE_HTTP_PORT=8081
EDGE_HTTPS_PORT=8443

# --- Published host ports (bound to the loopback interface only) ---
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=3000

# --- Application connection pool (sits in front of PgBouncer) ---
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

# --- Observability ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=exam_local_grafana_password
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3001
LOKI_HOST_PORT=3100

# Static bearer token the Prometheus scrape job presents on /actuator/** (GAP-138). It grants the
# MONITORING_SCOPE authority — permission to read metrics and nothing else — and is NOT a user
# credential: presenting it on /api/** authenticates nothing. Leave the backend's copy and this one
# consistent. This value is a development default; production must supply its own from the secret
# manager and must never commit it. When unset, the actuator tree fails closed and requires a normal
# principal holding SYSTEM_HEALTH_VIEW.
MONITORING_METRICS_TOKEN=local-monitoring-token-change-me
