# ---------------------------------------------------------------------------
# Frontend environment configuration (example).
# Copy to `.env.local` for local development. Never commit real secrets.
#
# Only NEXT_PUBLIC_* values are exposed to the browser. Never place a secret in a
# NEXT_PUBLIC_* variable (specs/09-P0-Foundation-V1.5.md §106).
# ---------------------------------------------------------------------------

# Base URL of the backend API (no trailing slash). The version prefix `/api/v1` is added
# automatically and is never added twice.
#
# Leave this EMPTY to call the API on the same origin as the page. That is the correct value for
# anything served through the Nginx edge, and it is what the container image is built with: the
# browser then works at `localhost`, `127.0.0.1`, a LAN address, or a hostname without a rebuild.
#
# Set an absolute origin only for the split-origin development workflow, where `next dev` runs on
# :3000 and the backend is reached directly on :8080. That deployment must also list the frontend
# origin in CORS_ALLOWED_ORIGINS on the backend.
NEXT_PUBLIC_API_BASE_URL=
