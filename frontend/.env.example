# ---------------------------------------------------------------------------
# Frontend environment configuration (example).
# Copy to `.env.local` for local development. Never commit real secrets.
#
# Only NEXT_PUBLIC_* values are exposed to the browser. Never place a secret in a
# NEXT_PUBLIC_* variable (specs/09-P0-Foundation-V1.5.md §106).
# ---------------------------------------------------------------------------

# Base URL of the backend API (no trailing slash).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
